          "hideOthers": true,
          "scale": 3
        },
        {
          "speakerId": "림",
          "text": "저게... 마왕?",
          "position": "Center",
          "expressionKey": "Sad",
          "backgroundKey": "Boss Room",
          "hideOthers": false
        },
        {
          "speakerId": "마왕",
          "text": "내 부하들을 모두 쓰러뜨렸구나 소녀여...",
