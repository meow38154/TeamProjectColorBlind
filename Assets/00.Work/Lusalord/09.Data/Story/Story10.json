          "expressionKey": "Angry",
          "backgroundKey": "Boss Room",
          "hideOthers": false 
        },
        {
          "speakerId": "림",
          "text": "당장 돌려달라고!",
          "position": "Center",
          "expressionKey": "Angry",
          "backgroundKey": "Boss Room",
          "hideOthers": false
        },
        {
