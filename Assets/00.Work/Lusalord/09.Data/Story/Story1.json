      "lines": [
        {
          
          "speakerId": "림",
          "text": "어느 날, 세계가 낯설게 느껴진다.",
          "position": "None",
          "backgroundKey": "House",
          "hideOthers": true
        },
        {
          "speakerId": "림",
          "text": "눈을 떠도 색이 점점 희미해지고,",
          "position": "None",
          "backgroundKey": "House",
          "hideOthers": false
        },
        {
          "speakerId": "림",
          "text": "점점 색의 기운이 옅어져 간다.",
          "position": "None",
          "backgroundKey": "House",
          "hideOthers": false
        },
        {
          "speakerId": "림",
          "text": "그렇다. 더 이상 색이 보이지 않게 된 것이다.",
          "position": "None",
          "backgroundKey": "House",
          "hideOthers": false
        },
        {
          "speakerId": "림",
          "text": "하... 이제 어떻게 하지?",
          "position": "Center",
          "expressionKey": "Sad",
          "backgroundKey": "Village",
          "hideOthers": true
        },
        {
          "speakerId": "림",
          "text": "이대로면 결국 모든 힘을 잃어 버릴텐데...",
          "position": "Center",
          "expressionKey": "Cry",
          "backgroundKey": "Village",
          "hideOthers": false
        },
        {
          "speakerId": "림",
          "text": "어?",
          "position": "Center",
          "expressionKey": "Surprise",
          "backgroundKey": "Village",
          "hideOthers": false
        },
        {
          "speakerId": "",
          "text": "",
          "position": "None",
          "backgroundKey": "SideSlime",
          "hideOthers": true
        },
        {
          "speakerId": "림",
          "text": "색... 색깔이 보이잖아?",
          "position": "Center",
          "expressionKey": "Surprise",
          "backgroundKey": "Village",
          "hideOthers": false
        },
        {
          "speakerId": "림",
          "text": "저쪽으로 가봐야겠어.",
